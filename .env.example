# TrackerCG — configuration template.
# Copy this file to `.env` (gitignored) and adjust the values.
#
# No external API keys are required: all market data comes from public
# sources (Scryfall, YGOPRODeck, and TCGGO scraping) with no registration.
#
# SECRET_KEY  — long random string. REQUIRED when DEBUG=false.
#               Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# DEBUG       — true in development; MUST be false in production.
# COOKIE_SECURE — true when served over HTTPS (sets the Secure flag on the
#               session cookie). Default false for local HTTP.
# RATE_LIMIT_ENABLED — global switch for slowapi (default true).
# TRUSTED_PROXY — set true ONLY when running behind a reverse proxy that
#               overwrites X-Forwarded-For; otherwise anyone can spoof it.
# JWT_LIFETIME_SECONDS — session length (default 3600).

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
COOKIE_SECURE=true
RATE_LIMIT_ENABLED=true
TRUSTED_PROXY=false
JWT_LIFETIME_SECONDS=3600
